{
  "name": "neobrui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:root": "PUBLIC_SITE_BASE=/ PUBLIC_SITE_URL=http://127.0.0.1:4321/ astro build",
    "build:pages": "PUBLIC_SITE_BASE=/neobrui/ PUBLIC_SITE_URL=https://tekgadgt.github.io/neobrui/ astro build",
    "preview": "vite preview",
    "preview:root": "vite preview --host 127.0.0.1 --port ${DOCS_PORT:-4321} --base /",
    "preview:pages": "vite preview --host 127.0.0.1 --port ${DOCS_PORT:-4321} --base /neobrui/",
    "check": "astro check",
    "test": "playwright test --config=playwright.config.js"
  },
  "dependencies": {"@tekgadgt/neobrui":"workspace:*"}
}
