{
  "name": "@tekgadgt/neobrui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Opt-in, reset-free Neobrutalist design system",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "repository": {"type": "git", "url": "git+https://github.com/TekGadgt/neobrui.git"},
  "homepage": "https://tekgadgt.github.io/neobrui/",
  "bugs": {"url": "https://github.com/TekGadgt/neobrui/issues"},
  "keywords": ["css", "design-system", "neobrutalism", "semantic-css", "web-accessibility"],
  "publishConfig": {"registry": "https://registry.npmjs.org/", "access": "public"},
  "exports": {
    ".": { "style": "./src/index.css", "default": "./src/index.css" },
    "./foundations.css": "./src/foundations.css",
    "./layout.css": "./src/layout.css",
    "./primitives.css": "./src/primitives.css",
    "./utilities.css": "./src/utilities.css",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md", "LICENSE", "skills/neobrui"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "pnpm --filter neobrui-docs build",
    "check": "pnpm test && pnpm --filter neobrui-docs check",
    "test:docs": "pnpm --filter neobrui-docs test",
    "pack:check": "npm pack --dry-run",
    "pack:smoke": "node --test tests/package-smoke.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.41.9",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "astro": "7.2.7",
    "vite": "7.3.6"
  },
  "packageManager": "pnpm@11.24.0"
}
