{
  "name": "neobrui-spike-0-harness",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "install:frozen": "pnpm install --frozen-lockfile",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:tailwind": "pnpm --filter neobrui-spike4-tailwind build",
    "validate:tokens": "node tests/token-schema.test.mjs",
    "build": "pnpm build:tokens && pnpm build:tailwind && vite build",
    "build:fixtures": "pnpm build && pnpm --filter neobrui-spike4-css-modules build && pnpm --filter neobrui-spike4-astro build && pnpm --filter neobrui-spike4-tailwind build",
    "test": "node --test tests/*.test.mjs && pnpm validate:tokens && playwright test",
    "verify": "pnpm install --frozen-lockfile && pnpm build:fixtures && pnpm test",
    "capture:chromium": "CAPTURE_EVIDENCE=1 pnpm exec playwright test --project=chromium",
    "build:package-spike": "node scripts/size-spike.mjs",
    "measure:size": "node scripts/size-spike.mjs",
    "verify:size": "node scripts/verify-size.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "qa:baseline": "node scripts/qa-rehearsal.mjs baseline",
    "qa:seeded": "node scripts/qa-rehearsal.mjs seeded",
    "qa:rehearsal": "node scripts/qa-rehearsal.mjs rehearsal"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "vite": "7.3.6"
  }
}
