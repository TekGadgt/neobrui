{
  "name": "neobrui",
  "version": "1.0.0",
  "description": "Opt-in, reset-free Neobrutalist design system",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "style": "./src/index.css", "default": "./src/index.css" },
    "./foundations.css": "./src/foundations.css",
    "./layout.css": "./src/layout.css",
    "./primitives.css": "./src/primitives.css",
    "./utilities.css": "./src/utilities.css",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md", "LICENSE", "docs/design-system/0001-centralized-neobrui-reset.md", "skills/neobrui"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "pnpm --filter neobrui-docs build",
    "check": "pnpm test && pnpm --filter neobrui-docs check",
    "test:docs": "pnpm --filter neobrui-docs test",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.41.9",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "astro": "7.2.7",
    "vite": "7.3.6"
  },
  "packageManager": "pnpm@11.24.0"
}
